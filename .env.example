# Copy this file to .env.local and fill in your values.

# Your live site URL (used for sitemap, canonical links and social previews)
NEXT_PUBLIC_SITE_URL=https://antony-mwandiki.vercel.app

# Contact form email (any SMTP provider; Gmail example below)
# For Gmail: enable 2-step verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=antonymwandiki26@gmail.com
SMTP_PASS=your-app-password
# Where messages are delivered (defaults to SMTP_USER)
CONTACT_TO=antonymwandiki26@gmail.com

# Optional: Google Search Console HTML tag verification code
NEXT_PUBLIC_GOOGLE_VERIFICATION=
